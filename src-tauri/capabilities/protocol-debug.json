{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "protocol-debug",
  "description": "Allows the isolated protocol debugger to receive read-only protocol traces and control its own window",
  "windows": ["protocol-debug"],
  "permissions": [
    "allow-protocol-trace",
    "allow-quit-application",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
